<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>io.github.nadia5129</groupId>
  <artifactId>centroidfinder</artifactId>
  <version>1.0-SNAPSHOT</version>

  <properties>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <!-- JUnit Jupiter -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.0</version>
      <scope>test</scope>
    </dependency>

    <!-- JavaCV: used for processing MP4 videos -->
    <dependency>
        <groupId>org.bytedeco</groupId>
        <artifactId>javacv-platform</artifactId>
        <version>1.5.12</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Surefire: runs the tests -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.3</version>
      </plugin>
      <!-- Exec: runs the main class -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.1.0</version>
        <configuration>
        <!-- Video processor: java -jar videoprocessor.jar inputPath outputCsv targetColor threshold -->
        <mainClass>io.github.nadia5129.centroidfinder.VideoSummaryApp</mainClass>

        <!-- Original image main class -->
        <!-- <mainClass>io.github.nadia5129.centroidfinder.ImageSummaryApp</mainClass> -->

        <!-- Temporarily run our JavaCV experiment -->
        <!-- <mainClass>io.github.nadia5129.centroidfinder.JavaCVExperiment</mainClass> -->
        </configuration>
      </plugin>
      <!-- Assembly: builds an executable JAR (target/videoprocessor.jar) with all dependencies inside -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-assembly-plugin</artifactId>
        <version>3.7.1</version>
        <configuration>
          <descriptorRefs>
            <descriptorRef>jar-with-dependencies</descriptorRef>
          </descriptorRefs>
          <archive>
            <manifest>
              <mainClass>io.github.nadia5129.centroidfinder.VideoSummaryApp</mainClass>
            </manifest>
            <manifestEntries>
              <!-- lets JavaCV load FFmpeg's native (C) code without warnings on newer Java versions -->
              <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
            </manifestEntries>
          </archive>
          <finalName>videoprocessor</finalName>
          <appendAssemblyId>false</appendAssemblyId>
        </configuration>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>single</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
