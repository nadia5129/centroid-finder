# Copy this file to .env and fill in your own values.
# .env is not committed (it has the Neon password), only this example is.

# Neon connection string (get it from the team privately, never put it on GitHub)
DATABASE_URL=

# Port the server runs on
PORT=3000

# Folder with the videos, like /Users/you/centroid-finder/processor/sampleInput
VIDEOS_DIR=

# Folder the result CSVs get written to
RESULTS_DIR=

# Path to the JAR, like /Users/you/centroid-finder/processor/target/videoprocessor.jar
JAR_PATH=
